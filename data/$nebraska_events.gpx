  <wpt lat="41.034" lon="-96.31525">
    <time>2026-10-30T18:00:00</time>
    <name>GCBWXJG</name>
    <desc>Frankenstein Friday 2026 by Bronco, Event Cache (1.0/1.0)</desc>
    <url>https://coord.info/GCBWXJG</url>
    <urlname>Frankenstein Friday 2026</urlname>
    <sym>Geocache</sym>
    <type>Geocache|Event Cache</type>
    <groundspeak:cache id="10579450" archived="False" available="True" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
      <groundspeak:name>Frankenstein Friday 2026</groundspeak:name>
      <groundspeak:placed_by>Bronco</groundspeak:placed_by>
      <groundspeak:owner id="14594485">Bronco</groundspeak:owner>
      <groundspeak:type>Event Cache</groundspeak:type>
      <groundspeak:container>Other</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="24" inc="1">Wheelchair accessible</groundspeak:attribute>
        <groundspeak:attribute id="6" inc="1">Recommended for kids</groundspeak:attribute>
        <groundspeak:attribute id="8" inc="1">Scenic view</groundspeak:attribute>
        <groundspeak:attribute id="25" inc="1">Parking nearby</groundspeak:attribute>
        <groundspeak:attribute id="2" inc="1">Access/parking fee</groundspeak:attribute>
        <groundspeak:attribute id="63" inc="1">Recommended for tourists</groundspeak:attribute>
        <groundspeak:attribute id="10" inc="1">Difficult climb</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.0</groundspeak:difficulty>
      <groundspeak:terrain>1.0</groundspeak:terrain>
      <groundspeak:country>United States</groundspeak:country>
      <groundspeak:state>Nebraska</groundspeak:state>
      <groundspeak:short_description html="True">&lt;b&gt;30 October 2026, 18:00 - 18:45&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;h2&gt;Frankenstein Friday is coming to...&lt;/h2&gt;

&lt;p&gt;&lt;img src="https://s3.amazonaws.com/gs-geo-images/e7c00b59-3b52-4981-afbe-14066beecaab_l.jpg" /&gt;&lt;/p&gt;

&lt;p&gt;- This is the 10th consecutive year of the Frankenstein Friday event.&lt;/p&gt;

&lt;p&gt;- It has been hosted in 9 different US States.&lt;/p&gt;

&lt;p&gt;- The event will take place near the Walter Scott Jr. Observation Tower in Eugene T. Mahoney State Park in Ashland, NE. This event cache is not far from the parking lot.&lt;/p&gt;

&lt;p&gt;- Official event time is 6:00pm - 6:45pm on October 30, 2026&lt;/p&gt;

&lt;p&gt;- Please expect a simple meet and greet style event that takes place outdoors.&lt;/p&gt;

&lt;p&gt;- Be sure to dress accordingly - this is a Fall event afterall.&lt;/p&gt;

&lt;p&gt;- Come say hi, socialize with your geocaching buddies, maybe meet someone new, and sign the logbook (if I remember to bring one)! Nothing more than that!&lt;/p&gt;

&lt;p&gt;&lt;u&gt;&lt;strong&gt;Past Frankenstein Friday Events:&lt;/strong&gt;&lt;/u&gt;&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;Colorado - &lt;a href="https://coord.info/GC7CJDE"&gt;Frankenstein Friday with BroncoCole&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;Minnesota - &lt;a href="https://coord.info/GC7YWMD"&gt;Frankenstein Friday 2018&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;Wisconsin - &lt;a href="https://coord.info/GC8AY7W"&gt;Frankenstein Friday 2019&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;Iowa - &lt;a href="https://coord.info/GC8ZMV5"&gt;Frankenstein Friday 2020&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;South Dakota - &lt;a href="https://coord.info/GC9EBJZ"&gt;Frankenstein Friday 2021&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;Minnesota - &lt;a href="https://coord.info/GCA0DCW"&gt;Frankenstein Friday 2022&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;North Dakota - &lt;a href="https://coord.info/GCAEN9Q"&gt;Frankenstein Friday 2023&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;Michigan - &lt;a href="https://coord.info/GCAW49K"&gt;Frankenstein Friday 2024&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;Missouri - &lt;a href="https://coord.info/GCB8JDX"&gt;Frankenstein Friday 2025&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;

&lt;p&gt;Celebrated each year on the last Friday of October, Frankenstein Friday pays homage to one of the greatest gothic stories of all time. In 1818, Mary Shelley wrote a novel about a young scientist named Victor Frankenstein who discovers how to give life to inanimate bodies. He creates a monster that pursues him to the ends of the earth and eventually destroys everything he holds dear. People often mistakenly use the name “Frankenstein” to refer to the hideous monster (famously played by Boris Karloff in the 1931 film), but Victor Frankenstein never gives his creation a name.&lt;/p&gt;
            </groundspeak:long_description>
      <groundspeak:encoded_hints>A Nebraska state park permit is required to enter. If you don't have one, daily and annual permits may be purchased at the park entrance.</groundspeak:encoded_hints>
      <groundspeak:logs>
        <groundspeak:log id="1390044593">
          <groundspeak:date>2026-10-18T19:00:00Z</groundspeak:date>
          <groundspeak:type>Will Attend</groundspeak:type>
          <groundspeak:finder id="1253738">Monty12</groundspeak:finder>
          <groundspeak:text encoded="False">I'm hopeful I can attend.</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1389985169">
          <groundspeak:date>2026-10-17T19:00:00Z</groundspeak:date>
          <groundspeak:type>Will Attend</groundspeak:type>
          <groundspeak:finder id="7083719">taxi mom</groundspeak:finder>
          <groundspeak:text encoded="False">Planning on it</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1389906760">
          <groundspeak:date>2026-10-17T14:33:09Z</groundspeak:date>
          <groundspeak:type>Will Attend</groundspeak:type>
          <groundspeak:finder id="23393306">Toonfanatic</groundspeak:finder>
          <groundspeak:text encoded="False">Looking forward to attending another Frankenstein event. Had a great time last year. Can’t wait to see what awaits us in Nebraska.</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1388568990">

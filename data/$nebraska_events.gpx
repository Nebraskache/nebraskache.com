  <wpt lat="40.900833" lon="-98.36195">
    <time>2026-08-08T09:00:00</time>
    <name>GCBV562</name>
    <desc>Breakfast in the Tri-Cities   Grand Island by CRKAT, Event Cache (1.0/1.5)</desc>
    <url>https://coord.info/GCBV562</url>
    <urlname>Breakfast in the Tri-Cities   Grand Island</urlname>
    <sym>Geocache</sym>
    <type>Geocache|Event Cache</type>
    <groundspeak:cache id="10527170" archived="False" available="True" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
      <groundspeak:name>Breakfast in the Tri-Cities   Grand Island</groundspeak:name>
      <groundspeak:placed_by>CRKAT</groundspeak:placed_by>
      <groundspeak:owner id="2176584">CRKAT</groundspeak:owner>
      <groundspeak:type>Event Cache</groundspeak:type>
      <groundspeak:container>Other</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="6" inc="1">Recommended for kids</groundspeak:attribute>
        <groundspeak:attribute id="8" inc="1">Scenic view</groundspeak:attribute>
        <groundspeak:attribute id="25" inc="1">Parking nearby</groundspeak:attribute>
        <groundspeak:attribute id="30" inc="1">Picnic tables nearby</groundspeak:attribute>
        <groundspeak:attribute id="28" inc="1">Public restrooms nearby</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.0</groundspeak:difficulty>
      <groundspeak:terrain>1.5</groundspeak:terrain>
      <groundspeak:country>United States</groundspeak:country>
      <groundspeak:state>Nebraska</groundspeak:state>
      <groundspeak:short_description html="True">&lt;b&gt;08 August 2026, 09:00 - 10:00&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;h2&gt;Geocache Description:&lt;/h2&gt;

&lt;p&gt;&amp;nbsp;&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;You are invited to attend our monthly geocaching breakfast event.&amp;nbsp; We will have the event at Stolley Park.&amp;nbsp; Come share your stories and enjoy some comaraderie with your fellow Geocachers.&amp;nbsp; You might even get some help with that hard hide or puzzle.&lt;/strong&gt;&lt;/p&gt;

&lt;p&gt;&lt;big&gt;Where:&amp;nbsp; Stolley Park&lt;/big&gt;&lt;br /&gt;
&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;2103 W. Stolley Park Rd, Grand Island, Ne&lt;br /&gt;
Date: August 8, 2026&lt;br /&gt;
Time: 9:00 A.M. - 10:00 AM&lt;/p&gt;

&lt;p&gt;All ages and all cachers are invited. We will provide donuts, drinks are on your own. There is no meeting or agenda - just come and visit and do some geo-socializing with other geocachers. Hope to see you there! Please bring your coins and TBs for discovery, and for everyone else to enjoy!!&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;Please post a will attend so we know how many donuts to bring.&amp;nbsp; Drinks are on your own.&lt;/strong&gt;&lt;/p&gt;

&lt;p&gt;&amp;nbsp;&lt;/p&gt;

&lt;p&gt;&lt;a href="http://nebraskache.com/"&gt;&lt;img height="112" src="https://img.geocaching.com/9102f957-c986-41b5-acdb-a076bd017129.jpg" width="224" /&gt;&lt;/a&gt;&lt;/p&gt;

&lt;p&gt;&lt;a href="http://nebraskache.com/"&gt;Hosted By Nebraskache&lt;/a&gt;&lt;/p&gt;

&lt;p&gt;&lt;a href="https://www.facebook.com/groups/107321656812/"&gt;&lt;img height="70" src="https://s3.amazonaws.com/gs-geo-images/19b6196d-f1d8-431b-9201-f4069d107ada_l.png" width="230" /&gt;&lt;/a&gt;&lt;/p&gt;

&lt;p&gt;As the geocache event owner, I ensure that these links to a local geocaching group that is active in the community and contributing to geocaching in positive ways. This link has not been checked by Geocaching HQ or by the reviewer.&lt;/p&gt;
</groundspeak:long_description>
      <groundspeak:encoded_hints>In a covered shelter with plenty of parking.</groundspeak:encoded_hints>
      <groundspeak:logs>
        <groundspeak:log id="1374649621">

  <wpt lat="42.469863" lon="-96.412745">
    <time>2026-08-15T19:00:00</time>
    <name>GCBVD3P</name>
    <desc>Let's Do Dinner and Talk Geocaching! by captainmath, Event Cache (1.0/1.5)</desc>
    <url>https://coord.info/GCBVD3P</url>
    <urlname>Let's Do Dinner and Talk Geocaching!</urlname>
    <sym>Geocache</sym>
    <type>Geocache|Event Cache</type>
    <groundspeak:cache id="10534785" archived="False" available="True" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
      <groundspeak:name>Let's Do Dinner and Talk Geocaching!</groundspeak:name>
      <groundspeak:placed_by>CaptainMath</groundspeak:placed_by>
      <groundspeak:owner id="530518">captainmath</groundspeak:owner>
      <groundspeak:type>Event Cache</groundspeak:type>
      <groundspeak:container>Other</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="59" inc="1">Food nearby</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.0</groundspeak:difficulty>
      <groundspeak:terrain>1.5</groundspeak:terrain>
      <groundspeak:country>United States</groundspeak:country>
      <groundspeak:state>Nebraska</groundspeak:state>
      <groundspeak:short_description html="True">&lt;b&gt;15 August 2026, 19:00 - 20:00&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;p&gt;&lt;span style="font-size:18px"&gt;Come and join us at 7:00pm at Tacos La Juanita for an informal evening gathering of geocachers.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;

&lt;p&gt;&lt;span style="font-size:large"&gt;We are a husband and wife geocaching team from Northeastern Pennsylvania with over 20 years experience, on a county run to find geocaches in as many different counties as possible, but our real pleasure is in meeting wonderful geocaching friends as we travel. We really hope meet and chat with as many of you as possible, and as much as you like, we are willing to share our experiences and helpful tips for using tools of the trade to help with your geocaching.&lt;/span&gt;&lt;/p&gt;

&lt;p&gt;&lt;span style="font-size:large"&gt;Please come out and join us for a fun gathering that may also help you with your geocaching!&lt;/span&gt;&lt;/p&gt;
</groundspeak:long_description>
      <groundspeak:encoded_hints>
      </groundspeak:encoded_hints>
      <groundspeak:logs>
        <groundspeak:log id="1377618004">
          <groundspeak:date>2026-08-09T19:00:00Z</groundspeak:date>
          <groundspeak:type>Will Attend</groundspeak:type>
          <groundspeak:finder id="506941">Vulcan64</groundspeak:finder>
          <groundspeak:text encoded="False">Added to my calendar. If I get my chores done I might be down</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1375728748">
          <groundspeak:date>2026-08-02T00:09:42Z</groundspeak:date>
          <groundspeak:type>Announcement</groundspeak:type>
          <groundspeak:finder id="530518">captainmath</groundspeak:finder>
          <groundspeak:text encoded="False">We are really looking forward to this event! We plan on offering to trade tags, offering to do a little Show/Tell on TOTTs and Geocaching software like Project-GC and/or Cachetur if any attendees are interested and otherwise just talk about our favorite hobby with our new friends - that's YOU! If you have interest in any of the topics listed above, please let me know in advance so I can be ready but one way or another we're going to have a great time even just to meet you and bring along a few door prizes to offer.</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1374908129">
          <groundspeak:date>2026-07-28T19:00:00Z</groundspeak:date>
          <groundspeak:type>Will Attend</groundspeak:type>
          <groundspeak:finder id="1816347">KD0XD</groundspeak:finder>
          <groundspeak:text encoded="False">2 for Tacos</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1374809647">
          <groundspeak:date>2026-07-28T17:26:19Z</groundspeak:date>
          <groundspeak:type>Publish Listing</groundspeak:type>
          <groundspeak:finder id="531429">Heartland Cacher</groundspeak:finder>
          <groundspeak:text encoded="False">Published</groundspeak:text>
        </groundspeak:log>
      </groundspeak:logs>
    </groundspeak:cache>
  </wpt>
  <wpt lat="41.20555" lon="-96.020383">
    <time>2026-08-10T11:00:00</time>
    <name>GCBTX8J</name>
    <desc>Omaha Lunch #86 by hwbas04, Event Cache (1.0/1.0)</desc>
    <url>https://coord.info/GCBTX8J</url>
    <urlname>Omaha Lunch #86</urlname>
    <sym>Geocache</sym>
    <type>Geocache|Event Cache</type>
    <groundspeak:cache id="10519560" archived="False" available="True" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
      <groundspeak:name>Omaha Lunch #86</groundspeak:name>
      <groundspeak:placed_by>hwbas04</groundspeak:placed_by>
      <groundspeak:owner id="1389142">hwbas04</groundspeak:owner>
      <groundspeak:type>Event Cache</groundspeak:type>
      <groundspeak:container>Other</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="24" inc="1">Wheelchair accessible</groundspeak:attribute>
        <groundspeak:attribute id="6" inc="1">Recommended for kids</groundspeak:attribute>
        <groundspeak:attribute id="25" inc="1">Parking nearby</groundspeak:attribute>
        <groundspeak:attribute id="59" inc="1">Food nearby</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.0</groundspeak:difficulty>
      <groundspeak:terrain>1.0</groundspeak:terrain>
      <groundspeak:country>United States</groundspeak:country>
      <groundspeak:state>Nebraska</groundspeak:state>
      <groundspeak:short_description html="True">&lt;b&gt;10 August 2026, 11:00 - 12:30&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;p&gt;Welcome to this monthly geocaching event series, which will hopefully take you to different locations each month for lunch in the greater Omaha area. Here is the info for July 2026:&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;When:&lt;/strong&gt; Monday, August 10th, 2026 (11:00am - 12:30pm)&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;Where:&lt;/strong&gt; &lt;em&gt;Winchester's Bar &amp; Grill      7002 Q St.   Omaha, NE  &lt;/em&gt;&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;What:&lt;/strong&gt; Winchester's is a popular, casual spot known for it's diner-style comfort food. The location is near Ralston and across from Funplex.  &lt;/p&gt;

&lt;p&gt;As always, no purchase is necessary. Just come by to visit and have a good time.  &lt;/p&gt;

&lt;p&gt;Event ownership is open to everyone, and the event owner decides on the date, time, and location, preferably someplace new to the event (see the long list of places already used). If you would like to be the event owner for next month, please attend this current event or coordinate with the current event owner before the next event.&lt;/p&gt;

&lt;p&gt;This monthly lunch has been going on since January 23, 2017... pretty impressive!&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;&lt;u&gt;Past Omaha Lunch Events&lt;/u&gt;&lt;/strong&gt;:&lt;br /&gt;
Omaha Lunch #001 at Don &amp;amp; Millies hosted by TeamDAAK&lt;br /&gt;
Omaha Lunch #002 at The Corner Kick - Street Tacos and Sports Cantina hosted by jenny08_1015&lt;br /&gt;
Omaha Lunch Bunch #03 at A+ Buffet and Mongolian Grill hosted by BilltheBear&lt;br /&gt;
Omaha Lunch Bunch #04 at Pizza Ranch hosted by TnT Utter&lt;br /&gt;

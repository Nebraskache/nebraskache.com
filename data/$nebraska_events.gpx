    <name>GCBVXF2</name>
    <desc>Lunch For A Little Cache Redux #62 by starsharon + Hubbie, Event Cache (1.0/1.0)</desc>
    <url>https://coord.info/GCBVXF2</url>
    <urlname>Lunch For A Little Cache Redux #62</urlname>
    <sym>Geocache</sym>

          <groundspeak:type>Attended</groundspeak:type>
          <groundspeak:finder id="841414">LadyGunslinger</groundspeak:finder>
          <groundspeak:text encoded="False">The BEST way to cap off the weekend of fun events!  You can never go wrong with pancakes and sausage!  Thanks BBM&amp;J for hosting and providing the best pancakes!</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1384294679">
          <groundspeak:date>2026-09-13T19:00:00Z</groundspeak:date>
          <groundspeak:type>Attended</groundspeak:type>
          <groundspeak:finder id="214408">cachephrase</groundspeak:finder>
          <groundspeak:text encoded="False">Yummy pancakes and sausage. Thanks for cooking a great breakfast for us to cap off a fun picnic weekend!</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1384286772">
          <groundspeak:date>2026-09-13T19:00:00Z</groundspeak:date>

      <groundspeak:owner id="20507951">CRVonFange</groundspeak:owner>
      <groundspeak:type>Event Cache</groundspeak:type>
      <groundspeak:container>Other</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="6" inc="1">Recommended for kids</groundspeak:attribute>
        <groundspeak:attribute id="7" inc="1">Takes less than one hour</groundspeak:attribute>
        <groundspeak:attribute id="25" inc="1">Parking nearby</groundspeak:attribute>
        <groundspeak:attribute id="32" inc="1">Bicycles</groundspeak:attribute>
        <groundspeak:attribute id="52" inc="1">Night cache</groundspeak:attribute>
        <groundspeak:attribute id="63" inc="1">Recommended for tourists</groundspeak:attribute>
        <groundspeak:attribute id="30" inc="1">Picnic tables nearby</groundspeak:attribute>
        <groundspeak:attribute id="28" inc="1">Public restrooms nearby</groundspeak:attribute>
        <groundspeak:attribute id="27" inc="1">Drinking water nearby</groundspeak:attribute>
        <groundspeak:attribute id="46" inc="1">Trucks/RVs</groundspeak:attribute>
        <groundspeak:attribute id="38" inc="1">Campfires</groundspeak:attribute>
        <groundspeak:attribute id="17" inc="0">Poisonous plants</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.0</groundspeak:difficulty>
      <groundspeak:terrain>1.5</groundspeak:terrain>
      <groundspeak:country>United States</groundspeak:country>
      <groundspeak:state>Nebraska</groundspeak:state>
      <groundspeak:short_description html="True">&lt;b&gt;29 September 2026, 19:15 - 20:00&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;h3&gt;&lt;!--StartFragment --&gt;&lt;span style="font-size:16px;"&gt;&lt;span style="font-family:Comic Sans MS,cursive;"&gt;Let’s show some classic Midwest hospitality to USAdotRun as they pass through town!&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;

&lt;p&gt; &lt;/p&gt;

&lt;h3&gt;&lt;span style="font-size:16px;"&gt;&lt;span style="font-family:Comic Sans MS,cursive;"&gt;Join us for a quick, flash-mob-style meetup at the Bressler Park fire pit just as the sun goes down. Whether you&amp;#39;re a lifelong local, a neighboring cacher grabbing a midweek caching fix, or a road-tripper passing through, everyone is welcome!&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;

&lt;p&gt; &lt;/p&gt;

&lt;h3&gt;&lt;span style="font-size:16px;"&gt;&lt;span style="font-family:Comic Sans MS,cursive;"&gt;Why come out?&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;

&lt;ul&gt;
	&lt;li&gt;
	&lt;h3&gt;&lt;span style="font-size:16px;"&gt;&lt;span style="font-family:Comic Sans MS,cursive;"&gt;Talk Shop: Swap caching stories and grab tips on nearby hidden gems (there might even be a new multi-cache in the park).&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;
	&lt;/li&gt;
	&lt;li&gt;
	&lt;h3&gt;&lt;span style="font-size:16px;"&gt;&lt;span style="font-family:Comic Sans MS,cursive;"&gt;Trackables: Trade trackables that need to keep moving.&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;
	&lt;/li&gt;
	&lt;li&gt;
	&lt;h3&gt;&lt;span style="font-size:16px;"&gt;&lt;span style="font-family:Comic Sans MS,cursive;"&gt;Log It: Sign the official event log to claim your smiley.&lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;
	&lt;/li&gt;
&lt;/ul&gt;

&lt;h3&gt; &lt;/h3&gt;

&lt;h3&gt;&lt;span style="font-size:16px;"&gt;&lt;span style="font-family:Comic Sans MS,cursive;"&gt;New to geocaching? Stop by to ask questions, meet the community, and learn tips and tricks from experienced veteran cachers. &lt;/span&gt;&lt;/span&gt;&lt;/h3&gt;

&lt;h3&gt; &lt;/h3&gt;

&lt;h3&gt;&lt;!--StartFragment --&gt;&lt;/h3&gt;

&lt;h3&gt;&lt;strong&gt;&lt;span style="font-size:16px;"&gt;&lt;span style="font-family:Comic Sans MS,cursive;"&gt;Don&amp;#39;t forget to log your &amp;quot;Will Attend&amp;quot; to ensure there is a s&amp;#39;more just for you!&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;/h3&gt;

&lt;h3&gt; &lt;/h3&gt;

&lt;p&gt;&lt;!--EndFragment --&gt;&lt;/p&gt;
</groundspeak:long_description>
      <groundspeak:encoded_hints>There is a nearby picnic shelter just in case it rains.</groundspeak:encoded_hints>

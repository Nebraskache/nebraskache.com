          <groundspeak:finder id="841414">LadyGunslinger</groundspeak:finder>
          <groundspeak:text encoded="False">Really hate to miss the 150th milestone!  Will try to stop by after our archery thing if it's not too late.  Have fun y'all!</groundspeak:text>
        </groundspeak:log>

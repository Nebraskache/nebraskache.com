    <groundspeak:cache id="10555710" archived="False" available="True" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
      <groundspeak:name>Geo Breakfast September</groundspeak:name>
      <groundspeak:placed_by>luvkenya</groundspeak:placed_by>
      <groundspeak:owner id="12391189">luvkenya</groundspeak:owner>

    </groundspeak:cache>
  </wpt>
  <wpt lat="40.653183" lon="-98.99735">
    <time>2026-09-13T08:00:00</time>
    <name>GCBW6GV</name>
    <desc>Pancake Breakfast 2026 by BBM&amp;J, Event Cache (1.0/1.0)</desc>
    <url>https://coord.info/GCBW6GV</url>
    <urlname>Pancake Breakfast 2026</urlname>
    <sym>Geocache</sym>
    <type>Geocache|Event Cache</type>
    <groundspeak:cache id="10558256" archived="False" available="True" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
      <groundspeak:name>Pancake Breakfast 2026</groundspeak:name>
      <groundspeak:placed_by>BBM&amp;J</groundspeak:placed_by>
      <groundspeak:owner id="143752">BBM&amp;J</groundspeak:owner>
      <groundspeak:type>Event Cache</groundspeak:type>
      <groundspeak:container>Other</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="24" inc="1">Wheelchair accessible</groundspeak:attribute>
        <groundspeak:attribute id="41" inc="1">Stroller accessible</groundspeak:attribute>
        <groundspeak:attribute id="7" inc="1">Takes less than one hour</groundspeak:attribute>
        <groundspeak:attribute id="30" inc="1">Picnic tables nearby</groundspeak:attribute>
        <groundspeak:attribute id="28" inc="1">Public restrooms nearby</groundspeak:attribute>
        <groundspeak:attribute id="31" inc="1">Camping nearby</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.0</groundspeak:difficulty>
      <groundspeak:terrain>1.0</groundspeak:terrain>
      <groundspeak:country>United States</groundspeak:country>
      <groundspeak:state>Nebraska</groundspeak:state>
      <groundspeak:short_description html="True">&lt;b&gt;13 September 2026, 08:00 - 09:00&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;p style="text-align:center;"&gt;&lt;span style="font-size:36px;"&gt;Pancake Breakfast&lt;/span&gt;&lt;/p&gt;

&lt;p&gt;The breakfast wraps up the weekend and takes place in the Fort Kearney State Recreation area a will run from approximately 8:00 A.M. - 9:00 A.M. on Sunday, September 13th 202 taking place at the shelter near camp site 69&lt;/p&gt;

&lt;p&gt;We will be making pancakes and holding a freewill donation.  Anything donated over the cost of breakfast supplies will be donated back to Nebraskache. Flatware, plates, and napkins will be provided. Gluten free pancakes will be available, just let us know&lt;/p&gt;

&lt;p&gt;NOTE: a valid NE State park permit is required. Permits are avaiable at the park entrance.&lt;/p&gt;

&lt;p&gt; Please post your &amp;quot;Will Attend&amp;quot; with number coming so we can plan food accordingly.&lt;/p&gt;


 

</groundspeak:long_description>
      <groundspeak:encoded_hints>
      </groundspeak:encoded_hints>
      <groundspeak:logs>
        <groundspeak:log id="1378376955">

      <groundspeak:name>Let's EAT! - CL (150) Big Milestone</groundspeak:name>
      <groundspeak:placed_by>cwalford2</groundspeak:placed_by>
      <groundspeak:owner id="7098330">cwalford2</groundspeak:owner>
      <groundspeak:type>Event Cache</groundspeak:type>
      <groundspeak:container>Other</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="7" inc="0">Takes less than one hour</groundspeak:attribute>
        <groundspeak:attribute id="52" inc="0">Night cache</groundspeak:attribute>
        <groundspeak:attribute id="49" inc="1">May require snowshoes</groundspeak:attribute>
        <groundspeak:attribute id="50" inc="1">May require cross country skis</groundspeak:attribute>
        <groundspeak:attribute id="11" inc="1">May require wading</groundspeak:attribute>
        <groundspeak:attribute id="12" inc="1">May require swimming</groundspeak:attribute>
        <groundspeak:attribute id="4" inc="1">Boat required</groundspeak:attribute>
        <groundspeak:attribute id="5" inc="1">Scuba gear required</groundspeak:attribute>
        <groundspeak:attribute id="64" inc="1">Tree climbing required</groundspeak:attribute>
        <groundspeak:attribute id="3" inc="1">Climbing gear required</groundspeak:attribute>
        <groundspeak:attribute id="10" inc="1">Difficult climb</groundspeak:attribute>
        <groundspeak:attribute id="23" inc="1">Dangerous area</groundspeak:attribute>
        <groundspeak:attribute id="21" inc="1">Cliff/falling rocks</groundspeak:attribute>
        <groundspeak:attribute id="20" inc="1">Abandoned mine</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.0</groundspeak:difficulty>
      <groundspeak:terrain>1.5</groundspeak:terrain>
      <groundspeak:country>United States</groundspeak:country>
      <groundspeak:state>Nebraska</groundspeak:state>
      <groundspeak:short_description html="True">&lt;b&gt;19 August 2026, 17:45 - 19:30&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;p&gt;An ongoing monthly Geocaching Dinner Event in Lincoln, open to everyone, especially good for geocachers new to the game.  It&amp;#39;s a great way to get tips and tricks, or help.&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt;Local and out-of-town geocachers are welcome and encouraged to attend. No 4-legged cachers here, sorry. Unless it&amp;#39;s a service dog, then that&amp;#39;s okay.&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt;No purchase is required to attend this event.&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt;Come join us for a nice suppertime get-together. This will be a great opportunity to plan a weekend geocaching trip with other cachers, ask for help on those caches or puzzle caches that are driving you crazy, trade/share Travel Bugs and/or other trackable items, or just have a nice dinner and trade geocaching stories or talk about whatever.&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt;Location: The Eatery, 2548 S. 48th Street, Lincoln&lt;/p&gt;

&lt;p&gt;Date: Wednesday, August 19th&lt;/p&gt;

&lt;p&gt;Start Time: 5:45 pm / End Time: 7:45 pm (end time varies, but restaurant closes at 8:00)&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt;We will have the party room, so if you’ll please log a Will Attend I can tell them an approximate number to expect they will be sure to have appropriate staff on hand to take care of us!&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt; &lt;/p&gt;
</groundspeak:long_description>
      <groundspeak:encoded_hints>In the party room!</groundspeak:encoded_hints>
      <groundspeak:logs>
        <groundspeak:log id="1375177826">
          <groundspeak:date>2026-07-30T19:00:00Z</groundspeak:date>
          <groundspeak:type>Write note</groundspeak:type>
          <groundspeak:finder id="841414">LadyGunslinger</groundspeak:finder>
          <groundspeak:text encoded="False">Really hate to miss the 150th milestone!  Will try to stop by after our archery thing if it's not too late.  Have fun y'all!</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1375177852">
          <groundspeak:date>2026-07-30T15:34:37Z</groundspeak:date>
          <groundspeak:type>Will Attend</groundspeak:type>
          <groundspeak:finder id="1411659">starsharon + Hubbie</groundspeak:finder>
          <groundspeak:text encoded="False">Hubbie and I plan on attending. </groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1375164721">
          <groundspeak:date>2026-07-30T14:29:09Z</groundspeak:date>
          <groundspeak:type>Publish Listing</groundspeak:type>
          <groundspeak:finder id="531429">Heartland Cacher</groundspeak:finder>
          <groundspeak:text encoded="False">Published</groundspeak:text>
        </groundspeak:log>
      </groundspeak:logs>
    </groundspeak:cache>
  </wpt>
  <wpt lat="42.469863" lon="-96.412745">
    <time>2026-08-15T19:00:00</time>
    <name>GCBVD3P</name>
    <desc>Let's Do Dinner and Talk Geocaching! by captainmath, Event Cache (1.0/1.5)</desc>
    <url>https://coord.info/GCBVD3P</url>
    <urlname>Let's Do Dinner and Talk Geocaching!</urlname>
    <sym>Geocache</sym>
    <type>Geocache|Event Cache</type>
    <groundspeak:cache id="10534785" archived="False" available="True" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
      <groundspeak:name>Let's Do Dinner and Talk Geocaching!</groundspeak:name>
      <groundspeak:placed_by>CaptainMath</groundspeak:placed_by>
      <groundspeak:owner id="530518">captainmath</groundspeak:owner>
      <groundspeak:type>Event Cache</groundspeak:type>
      <groundspeak:container>Other</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="59" inc="1">Food nearby</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.0</groundspeak:difficulty>
      <groundspeak:terrain>1.5</groundspeak:terrain>
      <groundspeak:country>United States</groundspeak:country>
      <groundspeak:state>Nebraska</groundspeak:state>
      <groundspeak:short_description html="True">&lt;b&gt;15 August 2026, 19:00 - 20:00&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;p&gt;&lt;span style="font-size:18px"&gt;Come and join us at 7:00pm at Tacos La Juanita for an informal evening gathering of geocachers.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;

&lt;p&gt;&lt;span style="font-size:large"&gt;We are a husband and wife geocaching team from Northeastern Pennsylvania with over 20 years experience, on a county run to find geocaches in as many different counties as possible, but our real pleasure is in meeting wonderful geocaching friends as we travel. We really hope meet and chat with as many of you as possible, and as much as you like, we are willing to share our experiences and helpful tips for using tools of the trade to help with your geocaching.&lt;/span&gt;&lt;/p&gt;

&lt;p&gt;&lt;span style="font-size:large"&gt;Please come out and join us for a fun gathering that may also help you with your geocaching!&lt;/span&gt;&lt;/p&gt;
</groundspeak:long_description>
      <groundspeak:encoded_hints>
      </groundspeak:encoded_hints>
      <groundspeak:logs>
        <groundspeak:log id="1375728748">
          <groundspeak:date>2026-08-02T00:09:42Z</groundspeak:date>
          <groundspeak:type>Announcement</groundspeak:type>
          <groundspeak:finder id="530518">captainmath</groundspeak:finder>
          <groundspeak:text encoded="False">We are really looking forward to this event! We plan on offering to trade tags, offering to do a little Show/Tell on TOTTs and Geocaching software like Project-GC and/or Cachetur if any attendees are interested and otherwise just talk about our favorite hobby with our new friends - that's YOU! If you have interest in any of the topics listed above, please let me know in advance so I can be ready but one way or another we're going to have a great time even just to meet you and bring along a few door prizes to offer.</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1374908129">
          <groundspeak:date>2026-07-28T19:00:00Z</groundspeak:date>
          <groundspeak:type>Will Attend</groundspeak:type>
          <groundspeak:finder id="1816347">KD0XD</groundspeak:finder>
          <groundspeak:text encoded="False">2 for Tacos</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1374809647">
          <groundspeak:date>2026-07-28T17:26:19Z</groundspeak:date>
          <groundspeak:type>Publish Listing</groundspeak:type>
          <groundspeak:finder id="531429">Heartland Cacher</groundspeak:finder>
          <groundspeak:text encoded="False">Published</groundspeak:text>
        </groundspeak:log>
      </groundspeak:logs>
    </groundspeak:cache>
  </wpt>
  <wpt lat="41.20555" lon="-96.020383">

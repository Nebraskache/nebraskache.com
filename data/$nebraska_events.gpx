        <groundspeak:attribute id="66" inc="1">Teamwork cache</groundspeak:attribute>
        <groundspeak:attribute id="51" inc="1">Special tool required</groundspeak:attribute>
        <groundspeak:attribute id="63" inc="1">Recommended for tourists</groundspeak:attribute>
        <groundspeak:attribute id="28" inc="0">Public restrooms nearby</groundspeak:attribute>
        <groundspeak:attribute id="59" inc="0">Food nearby</groundspeak:attribute>
        <groundspeak:attribute id="27" inc="0">Drinking water nearby</groundspeak:attribute>

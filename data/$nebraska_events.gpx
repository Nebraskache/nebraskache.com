    <desc>Geo Breakfast October by luvkenya, Event Cache (1.0/1.0)</desc>
    <url>https://coord.info/GCBYJTK</url>
    <urlname>Geo Breakfast October</urlname>
    <sym>Geocache</sym>
    <type>Geocache|Event Cache</type>
    <groundspeak:cache id="10629642" archived="False" available="True" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
      <groundspeak:name>Geo Breakfast October</groundspeak:name>
      <groundspeak:placed_by>luvkenya</groundspeak:placed_by>
      <groundspeak:owner id="12391189">luvkenya</groundspeak:owner>
      <groundspeak:type>Event Cache</groundspeak:type>
      <groundspeak:container>Other</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="24" inc="1">Wheelchair accessible</groundspeak:attribute>
        <groundspeak:attribute id="25" inc="1">Parking nearby</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.0</groundspeak:difficulty>
      <groundspeak:terrain>1.0</groundspeak:terrain>
      <groundspeak:country>United States</groundspeak:country>
      <groundspeak:state>Nebraska</groundspeak:state>
      <groundspeak:short_description html="True">&lt;b&gt;17 October 2026, 08:00 - 09:00&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;p&gt; &lt;/p&gt;

&lt;p&gt;Please join your fellow cachers for the monthly Hy-Vee Deli Caching breakfast.  Come wearing a fun costume of choice and enjoy a meal together or just swap fun or scary stories and adventures from the trail.&lt;/p&gt;

&lt;p&gt;The deli is wheelchair accessible and offers three options: a full breakfast menu, purchase something from the store and eat it at the event, or just join us for the fun (no purchase necessary).&lt;/p&gt;

&lt;p&gt;*as always, no purchase required to attend*&lt;/p&gt;
&lt;p&gt;Additional Waypoints&lt;/p&gt;P0BYJTK - Hy-Vee Parking Lot&lt;br /&gt;N 41° 15.914 W 096° 02.359&lt;br /&gt;Park in the lot near Hy-Vee entrance&lt;br /&gt;</groundspeak:long_description>
      <groundspeak:encoded_hints>
      </groundspeak:encoded_hints>

    <name>GCBVFXM</name>
    <desc>Let's EAT! - CL (150) Big Milestone by cwalford2, Event Cache (1.0/1.5)</desc>
    <url>https://coord.info/GCBVFXM</url>
    <urlname>Let's EAT! - CL (150) Big Milestone</urlname>
    <sym>Geocache</sym>
    <type>Geocache|Event Cache</type>
    <groundspeak:cache id="10537480" archived="False" available="True" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
      <groundspeak:name>Let's EAT! - CL (150) Big Milestone</groundspeak:name>
      <groundspeak:placed_by>cwalford2</groundspeak:placed_by>
      <groundspeak:owner id="7098330">cwalford2</groundspeak:owner>
      <groundspeak:type>Event Cache</groundspeak:type>
      <groundspeak:container>Other</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="7" inc="0">Takes less than one hour</groundspeak:attribute>
        <groundspeak:attribute id="52" inc="0">Night cache</groundspeak:attribute>
        <groundspeak:attribute id="49" inc="1">May require snowshoes</groundspeak:attribute>
        <groundspeak:attribute id="50" inc="1">May require cross country skis</groundspeak:attribute>
        <groundspeak:attribute id="11" inc="1">May require wading</groundspeak:attribute>
        <groundspeak:attribute id="12" inc="1">May require swimming</groundspeak:attribute>
        <groundspeak:attribute id="4" inc="1">Boat required</groundspeak:attribute>
        <groundspeak:attribute id="5" inc="1">Scuba gear required</groundspeak:attribute>
        <groundspeak:attribute id="64" inc="1">Tree climbing required</groundspeak:attribute>
        <groundspeak:attribute id="3" inc="1">Climbing gear required</groundspeak:attribute>
        <groundspeak:attribute id="10" inc="1">Difficult climb</groundspeak:attribute>
        <groundspeak:attribute id="23" inc="1">Dangerous area</groundspeak:attribute>
        <groundspeak:attribute id="21" inc="1">Cliff/falling rocks</groundspeak:attribute>
        <groundspeak:attribute id="20" inc="1">Abandoned mine</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.0</groundspeak:difficulty>
      <groundspeak:terrain>1.5</groundspeak:terrain>
      <groundspeak:country>United States</groundspeak:country>
      <groundspeak:state>Nebraska</groundspeak:state>
      <groundspeak:short_description html="True">&lt;b&gt;19 August 2026, 17:45 - 19:30&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;p&gt;An ongoing monthly Geocaching Dinner Event in Lincoln, open to everyone, especially good for geocachers new to the game.  It&amp;#39;s a great way to get tips and tricks, or help.&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt;Local and out-of-town geocachers are welcome and encouraged to attend. No 4-legged cachers here, sorry. Unless it&amp;#39;s a service dog, then that&amp;#39;s okay.&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt;No purchase is required to attend this event.&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt;Come join us for a nice suppertime get-together. This will be a great opportunity to plan a weekend geocaching trip with other cachers, ask for help on those caches or puzzle caches that are driving you crazy, trade/share Travel Bugs and/or other trackable items, or just have a nice dinner and trade geocaching stories or talk about whatever.&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt;Location: The Eatery, 2548 S. 48th Street, Lincoln&lt;/p&gt;

&lt;p&gt;Date: Wednesday, August 19th&lt;/p&gt;

&lt;p&gt;Start Time: 5:45 pm / End Time: 7:45 pm (end time varies, but restaurant closes at 8:00)&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt;We will have the party room, so if you’ll please log a Will Attend I can tell them an approximate number to expect they will be sure to have appropriate staff on hand to take care of us!&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt; &lt;/p&gt;
</groundspeak:long_description>
      <groundspeak:encoded_hints>In the party room!</groundspeak:encoded_hints>

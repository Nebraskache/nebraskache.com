      <groundspeak:short_description html="True">&lt;b&gt;05 October 2026, 10:00 - 10:30&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;h2 style="text-align:center;"&gt;&lt;img src="https://img.geocaching.com:443/20cdeef5-f181-4020-83dc-5799d2bd1fb3.jpg" /&gt;&lt;br /&gt;
 &lt;/h2&gt;

&lt;h2 style="text-align:center;"&gt;London Calling on Tour in Nebraska - exactly 100 degrees west of Greenwich, London&lt;/h2&gt;

&lt;h2 style="text-align:center;"&gt;Monday, October 5, 2026, 10am to 10.30am&lt;/h2&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt;Welcome to the geocaching event in the middle of Nebraska, not at any old place on the prairies but exactly 100° west from London, England.&lt;br /&gt;
Join the hosts from this English capital city to chat about all things geocaching. We are on a tour of the Midwest visiting States that we haven&amp;#39;t been to before. &lt;br /&gt;
Meet 100° on the Cowboy Trail, parking is nearby, waypoint given. The Cowboy Trail is a multi used trail along the old railroad route...there is something here! &lt;br /&gt;
 &lt;/p&gt;

&lt;p&gt;London Calling 2027 Mega takes place on May 8 at Greenwich, London -  the home of the coordinates and time. &lt;br /&gt;
&lt;a href="https://coord.info/GCBJK18"&gt;London Calling Mega link&lt;/a&gt;&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;
&lt;p&gt;Additional Waypoints&lt;/p&gt;P0BVK0H - Parking at Memorial&lt;br /&gt;N 42° 33.570 W 100° 00.500&lt;br /&gt;&lt;br /&gt;</groundspeak:long_description>
      <groundspeak:encoded_hints>Easy, we will probably be the only people here.</groundspeak:encoded_hints>
      <groundspeak:logs>
        <groundspeak:log id="1376149884">
          <groundspeak:date>2026-08-03T19:00:00Z</groundspeak:date>
          <groundspeak:type>Will Attend</groundspeak:type>
          <groundspeak:finder id="465298">goldpot</groundspeak:finder>
          <groundspeak:text encoded="False">Will be there, 100 degrees from home! </groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1376149328">
          <groundspeak:date>2026-08-03T16:44:17Z</groundspeak:date>
          <groundspeak:type>Publish Listing</groundspeak:type>
          <groundspeak:finder id="531429">Heartland Cacher</groundspeak:finder>
          <groundspeak:text encoded="False">Published</groundspeak:text>
        </groundspeak:log>
      </groundspeak:logs>
    </groundspeak:cache>
  </wpt>
  <wpt lat="41.114417" lon="-102.952167">
    <time>2026-10-01T21:00:00</time>
    <name>GCBXVFV</name>
    <desc>World Postcard Day Event Nebraska by Aegir101, Event Cache (1.0/1.0)</desc>
    <url>https://coord.info/GCBXVFV</url>
    <urlname>World Postcard Day Event Nebraska</urlname>
    <sym>Geocache</sym>
    <type>Geocache|Event Cache</type>
    <groundspeak:cache id="10607236" archived="False" available="True" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
      <groundspeak:name>World Postcard Day Event Nebraska</groundspeak:name>
      <groundspeak:placed_by>Aegir101</groundspeak:placed_by>
      <groundspeak:owner id="19483995">Aegir101</groundspeak:owner>
      <groundspeak:type>Event Cache</groundspeak:type>
      <groundspeak:container>Other</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="24" inc="1">Wheelchair accessible</groundspeak:attribute>
        <groundspeak:attribute id="41" inc="1">Stroller accessible</groundspeak:attribute>
        <groundspeak:attribute id="1" inc="0">Dogs</groundspeak:attribute>
        <groundspeak:attribute id="25" inc="1">Parking nearby</groundspeak:attribute>
        <groundspeak:attribute id="52" inc="1">Night cache</groundspeak:attribute>
        <groundspeak:attribute id="63" inc="1">Recommended for tourists</groundspeak:attribute>
        <groundspeak:attribute id="28" inc="1">Public restrooms nearby</groundspeak:attribute>
        <groundspeak:attribute id="59" inc="1">Food nearby</groundspeak:attribute>
        <groundspeak:attribute id="27" inc="1">Drinking water nearby</groundspeak:attribute>
        <groundspeak:attribute id="37" inc="0">Horses</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.0</groundspeak:difficulty>
      <groundspeak:terrain>1.0</groundspeak:terrain>
      <groundspeak:country>United States</groundspeak:country>
      <groundspeak:state>Nebraska</groundspeak:state>
      <groundspeak:short_description html="True">&lt;b&gt;01 October 2026, 21:00 - 22:00&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;p&gt;Two cachers from the National Capital Region aka the DMV (Washington DC, Maryland,&amp;nbsp;and Virginia) are wandering around Colorado, Nebraska, Kansas and Wyoming for another crazy caching trip. Sidney NE is our first stop on a 5-day caching binge, please come&amp;nbsp;meet up with us. Thursday&amp;nbsp;night we are hoping to meet some local cachers, share caching stories, and get recommendations for our trip.&amp;nbsp; If you can attend you can qualify for the World Postcard Day Souvenir.&lt;/p&gt;

&lt;p&gt;We plan to meet at 9pm at the Applebees 625 Cabela Dr Sidney NE 69162.&amp;nbsp;We plan to get food and drink, but come by just for food, just for a drink, or just to talk caching (no purchase necessary).&amp;nbsp; Please log a will attend so we can tell the restaurant the size of table we need, if you end up showing up at the last minute dont worry we can squeeze you in. We hope that you can join us!&lt;/p&gt;
</groundspeak:long_description>
      <groundspeak:encoded_hints>
      </groundspeak:encoded_hints>
      <groundspeak:logs>
        <groundspeak:log id="1384801787">

  <wpt lat="40.83082" lon="-97.59417">
    <time>2026-09-25T17:00:00</time>
    <name>GCBXV3Z</name>
    <desc>7th Annual Random County Road Trip by papazulu, Event Cache (1.0/1.0)</desc>
    <url>https://coord.info/GCBXV3Z</url>
    <urlname>7th Annual Random County Road Trip</urlname>
    <sym>Geocache</sym>
    <type>Geocache|Event Cache</type>
    <groundspeak:cache id="10606868" archived="False" available="True" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
      <groundspeak:name>7th Annual Random County Road Trip</groundspeak:name>
      <groundspeak:placed_by>papazulu</groundspeak:placed_by>
      <groundspeak:owner id="329323">papazulu</groundspeak:owner>
      <groundspeak:type>Event Cache</groundspeak:type>
      <groundspeak:container>Other</groundspeak:container>
      <groundspeak:attributes>
        <groundspeak:attribute id="24" inc="1">Wheelchair accessible</groundspeak:attribute>
        <groundspeak:attribute id="41" inc="1">Stroller accessible</groundspeak:attribute>
        <groundspeak:attribute id="7" inc="1">Takes less than one hour</groundspeak:attribute>
        <groundspeak:attribute id="25" inc="1">Parking nearby</groundspeak:attribute>
        <groundspeak:attribute id="58" inc="1">Fuel nearby</groundspeak:attribute>
        <groundspeak:attribute id="29" inc="1">Telephone nearby</groundspeak:attribute>
        <groundspeak:attribute id="64" inc="0">Tree climbing required</groundspeak:attribute>
        <groundspeak:attribute id="10" inc="0">Difficult climb</groundspeak:attribute>
        <groundspeak:attribute id="54" inc="0">Abandoned structure</groundspeak:attribute>
        <groundspeak:attribute id="17" inc="0">Poisonous plants</groundspeak:attribute>
      </groundspeak:attributes>
      <groundspeak:difficulty>1.0</groundspeak:difficulty>
      <groundspeak:terrain>1.0</groundspeak:terrain>
      <groundspeak:country>United States</groundspeak:country>
      <groundspeak:state>Nebraska</groundspeak:state>
      <groundspeak:short_description html="True">&lt;b&gt;25 September 2026, 17:00 - 17:30&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;p&gt; Join us on Friday, September 25 from 5-530 PM at the new White Elm Brewing Company Brewery in York, Nebraska.  Every year since 2020, I have done a geo-trip to a random county and this year&amp;#39;s lucky draw was none other than York County, Nebraska!  We&amp;#39;ll be in town for a couple hours and this new brewery sounded like a great place to get together, meet some locals, slap a beer and draw my pick for next years road trip.  This brewery here just opened in August and is located at 316 Holoch Street in York, Nebraska. There is no purchase necessary to attend this event. Having a drink or buying food is not a requirement whatsoever, however if you choose to, each attendee will be responsible for their own bill.&lt;/p&gt;

&lt;p&gt;   Each year since 2020 I have picked a U.S. County at random and traveled there to check it out.  I use a random number generator to pick the state, then again use a random number generator to pick the county, both alphabetically.  Towards the end of the event we will be drawing next years destination.  The only catch is no duplicates allowed!&lt;/p&gt;

&lt;p&gt; &lt;/p&gt;

&lt;p&gt;Past trips have included:&lt;/p&gt;

&lt;p&gt;2020 - Ozaukee County, Wisconsin&lt;/p&gt;

&lt;p&gt;2021 - Burleson County, Texas&lt;/p&gt;

&lt;p&gt;2022 - Pawnee County, Nebraska&lt;/p&gt;

&lt;p&gt;2023 - Rice County, Kansas&lt;/p&gt;

&lt;p&gt;2024 - Weston County, Wyoming&lt;/p&gt;

&lt;p&gt;2025 - Payette County, Idaho&lt;/p&gt;
</groundspeak:long_description>
      <groundspeak:encoded_hints>316 Holoch Street York, NE</groundspeak:encoded_hints>
      <groundspeak:logs>
        <groundspeak:log id="1384776810">
          <groundspeak:date>2026-09-16T18:24:38Z</groundspeak:date>
          <groundspeak:type>Write note</groundspeak:type>
          <groundspeak:finder id="2176584">CRKAT</groundspeak:finder>
          <groundspeak:text encoded="False">Our plans have changed, and we will not make the event.  So disappointed.  Have fun.</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1383941000">
          <groundspeak:date>2026-09-12T04:41:54Z</groundspeak:date>
          <groundspeak:type>Will Attend</groundspeak:type>
          <groundspeak:finder id="5417100">THC73*</groundspeak:finder>
          <groundspeak:text encoded="False">Going to try and stop by for a few minutes</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1383844178">
          <groundspeak:date>2026-09-11T14:36:10Z</groundspeak:date>

      <groundspeak:short_description html="True">&lt;b&gt;17 July 2026, 09:30 - 10:00&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;p&gt;&lt;span style="font-size:12pt;"&gt;&lt;span style="font-family:Calibri,sans-serif;"&gt;Starbucks&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p&gt;&lt;span style="font-size:12pt;"&gt;&lt;span style="font-family:Calibri,sans-serif;"&gt;707 Talmadge St, Kearney, NE 68845&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p&gt;&lt;span style="font-size:12pt;"&gt;&lt;span style="font-family:Calibri,sans-serif;"&gt;In Kearney for work. If you have normal-sized trackables that you want moved, feel free to stop by. I will swap what trackables that I have.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;


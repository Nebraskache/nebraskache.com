    <name>GCBM67E</name>
    <desc>MOGA 2027 by MOGA2027, Mega-Event Cache (1.0/1.0)</desc>
    <url>https://coord.info/GCBM67E</url>
    <urlname>MOGA 2027</urlname>
    <sym>Geocache</sym>

      <groundspeak:short_description html="True">&lt;b&gt;08 August 2026, 08:00 - 09:00&lt;/b&gt;</groundspeak:short_description>
      <groundspeak:long_description html="True">&lt;p&gt;&lt;strong&gt;&lt;span style="font-size:18px"&gt;&lt;span style="font-family:Trebuchet MS,Helvetica,sans-serif"&gt;August 8, 2026&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;

&lt;p&gt;&lt;strong&gt;&lt;span style="font-size:18px"&gt;&lt;span style="font-family:Trebuchet MS,Helvetica,sans-serif"&gt;8 am - 9 am&lt;/span&gt;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;

&lt;p style="text-align:center"&gt;&amp;nbsp;&lt;/p&gt;

&lt;p style="text-align:center"&gt;&lt;span style="font-size:16px"&gt;&lt;span style="font-family:Trebuchet MS,Helvetica,sans-serif"&gt;Please join your fellow cachers for the monthly HyVee Deli Caching Breakfast.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p style="text-align:center"&gt;&lt;span style="font-size:16px"&gt;&lt;span style="font-family:Trebuchet MS,Helvetica,sans-serif"&gt;Come enjoy a meal together or just swap stories and adventures from the trail.&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p style="text-align:center"&gt;&amp;nbsp;&lt;/p&gt;

&lt;p&gt;&lt;span style="font-size:16px"&gt;&lt;span style="font-family:Trebuchet MS,Helvetica,sans-serif"&gt;The deli is wheelchair accessible and offers three options: a full breakfast menu, purchase something from the store and eat it at the event, or just join us for the fun (no purchase necessary).&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;

&lt;p&gt;&amp;nbsp;&lt;/p&gt;

&lt;p style="text-align:center"&gt;&lt;span style="font-size:14px"&gt;&lt;span style="font-family:Trebuchet MS,Helvetica,sans-serif"&gt;&lt;em&gt;*as always, no purchase required to attend*&lt;/em&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;
</groundspeak:long_description>

    <groundspeak:cache id="10349428" archived="False" available="True" xmlns:groundspeak="http://www.groundspeak.com/cache/1/0/1">
      <groundspeak:name>MOGA 2027</groundspeak:name>
      <groundspeak:placed_by>MOGA2027</groundspeak:placed_by>
      <groundspeak:owner id="54849623">MOGA2027</groundspeak:owner>
